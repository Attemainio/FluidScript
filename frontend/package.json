    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^28.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "oxlint": "^1.79.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
