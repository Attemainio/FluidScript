# Line endings are forced to LF on everything the build or the tests read.
#
# Windows tooling CRLF-ing a .cs file breaks raw string literals in golden-file tests, and the
# failure looks like a logic bug rather than a checkout artefact. *.fluid matters doubly: script
# tests compare text spans by byte offset, so a CRLF shifts every span in the file by one per line.
# See plan/00-foundation/03-repository-layout.md.

* text=auto eol=lf

*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.sh        text eol=lf
*.fluid     text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.yml       text eol=lf

*.png       binary
*.jpg       binary
*.gif       binary
*.svg       text eol=lf
