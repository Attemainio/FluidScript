{
  "title": "Metadata",
  "description": "The static description of the language, the body of GET /api/v1/metadata (42).",
  "type": "object",
  "properties": {
    "restMajor": {
      "description": "The REST major this document describes; the v1 in the path.",
      "type": "integer"
    },
    "contractVersion": {
      "description": "The model contract version compile returns.",
      "type": "string"
    },
    "language": {
      "title": "LanguageVersions",
      "description": "The language majors this build reads.",
      "type": "object",
      "properties": {
        "current": {
          "description": "The major a new script is written in.",
          "type": "integer"
        },
        "supported": {
          "description": "Every major this build parses, including the current one.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "current",
        "supported"
      ]
    },
    "kinds": {
      "description": "Every component kind, in registry order.",
      "type": "array",
      "items": {
        "title": "Kind",
        "description": "One component kind as the script can write it.",
        "type": "object",
        "properties": {
          "keyword": {
            "description": "The canonical keyword.",
            "type": "string"
          },
          "aliases": {
            "description": "Other spellings the binder accepts and reads as the keyword.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tagCode": {
            "description": "The equipment-tag code (D-34), or null when the kind is not tagged.",
            "type": [
              "string",
              "null"
            ]
          },
          "drivesFlow": {
            "description": "Whether the kind drives flow, as a pump does.",
            "type": "boolean"
          },
          "isObserver": {
            "description": "Whether the kind observes rather than carries flow: a sensor or a controller.",
            "type": "boolean"
          },
          "symbolId": {
            "description": "The symbol that draws it, an id into Symbols.",
            "type": "string"
          },
          "ports": {
            "description": "The fixed ports, in declaration order.",
            "type": "array",
            "items": {
              "title": "Port",
              "description": "One fixed port.",
              "type": "object",
              "properties": {
                "name": {
                  "description": "The port name as written after a dot.",
                  "type": "string"
                },
                "role": {
                  "description": "inlet, outlet or bidirectional.",
                  "type": "string"
                },
                "optional": {
                  "description": "Whether inference rule I3 leaves it unconnected without a boundary node.",
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "role",
                "optional"
              ]
            }
          },
          "portFamilies": {
            "description": "Indexed port families such as a tank\u0027s in[2]..in[16] (D-32, D-120).",
            "type": "array",
            "items": {
              "title": "PortFamily",
              "description": "An indexed port family.",
              "type": "object",
              "properties": {
                "prefix": {
                  "description": "The name before the index, in for the port id in2: a component\u0027s port ids and the model\u0027s keys are {Prefix}{index}.",
                  "type": "string"
                },
                "pattern": {
                  "description": "How a script writes a member, with one {index} placeholder: in[{index}] (D-120). The first member is the fixed port in, listed under ports.",
                  "type": "string"
                },
                "minIndex": {
                  "description": "The lowest index the family itself covers; the fixed first port sits below it.",
                  "type": "integer"
                },
                "maxIndex": {
                  "description": "The highest index.",
                  "type": "integer"
                },
                "role": {
                  "description": "inlet, outlet or bidirectional.",
                  "type": "string"
                },
                "levelParameterSuffix": {
                  "description": "The suffix of the parameter key that places the port (in2_level), or null; the script spelling of that parameter is under indexedParameters.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "prefix",
                "pattern",
                "minIndex",
                "maxIndex",
                "role",
                "levelParameterSuffix"
              ]
            }
          },
          "parameters": {
            "description": "The parameters, in the registry\u0027s order.",
            "type": "array",
            "items": {
              "title": "ParameterMeta",
              "description": "One parameter of a kind.",
              "type": "object",
              "properties": {
                "name": {
                  "description": "The canonical name.",
                  "type": "string"
                },
                "aliases": {
                  "description": "Other spellings the binder accepts.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "valueKind": {
                  "description": "quantity, symbol or reference.",
                  "type": "string"
                },
                "dimension": {
                  "description": "The dimension\u0027s name, an entry in Dimensions; null for a synthesised dimension such as W/(m\u00B2\u00B7K), which Unit alone names.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "description": "The unit a bare number means and values are reported in, or null for a dimensionless parameter.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "acceptedSymbols": {
                  "description": "The symbols a symbol-valued parameter accepts, such as a valve characteristic.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "omission": {
                  "description": "What omitting it means: size, default or require (D-02).",
                  "type": "string"
                },
                "default": {
                  "description": "The default as the script would write it, when the omission policy is default.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "defaultBasis": {
                  "description": "Why that default, in the registry\u0027s words.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usualRange": {
                  "title": "RangeMeta",
                  "description": "The range a stated value usually falls in, or null.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "min": {
                      "description": "The lowest value.",
                      "type": "number"
                    },
                    "max": {
                      "description": "The highest value.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ]
                },
                "validRange": {
                  "title": "RangeMeta",
                  "description": "The range outside which a stated value is an error, or null.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "min": {
                      "description": "The lowest value.",
                      "type": "number"
                    },
                    "max": {
                      "description": "The highest value.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ]
                },
                "wholeNumber": {
                  "description": "Whether a stated value must be a whole number.",
                  "type": "boolean"
                },
                "displayPrecision": {
                  "description": "Significant digits a display shows.",
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "aliases",
                "valueKind",
                "dimension",
                "unit",
                "acceptedSymbols",
                "omission",
                "default",
                "defaultBasis",
                "usualRange",
                "validRange",
                "wholeNumber",
                "displayPrecision"
              ]
            }
          },
          "indexedParameters": {
            "description": "Indexed parameter families such as a tank\u0027s t{index}.",
            "type": "array",
            "items": {
              "title": "IndexedParameter",
              "description": "An indexed parameter family.",
              "type": "object",
              "properties": {
                "pattern": {
                  "description": "The name with {index} where the index goes.",
