    "symbols": {
      "description": "The symbol definitions the canvas draws with (D-24), the same records the model contract carries.",
      "type": "array",
      "items": {
        "title": "Symbol",
        "description": "A symbol definition in a normalized box (D-20, D-102).",
        "type": "object",
        "properties": {
          "id": {
            "description": "The id components reference, kind.variant.",
            "type": "string"
          },
          "viewBox": {
            "description": "The bounding box as [x, y, width, height] in symbol units; what layout reasons on.",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "primitives": {
            "description": "What the canvas draws inside the box. Never executable.",
            "type": "array",
            "items": {
              "title": "Primitive",
              "description": "One drawing primitive; the fields a kind does not use are absent.",
              "type": "object",
              "properties": {
                "kind": {
                  "description": "rect, line, circle, polyline or polygon.",
                  "type": "string"
                },
                "x": {
                  "description": "A rectangle\u0027s or circle\u0027s origin.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "y": {
                  "description": "A rectangle\u0027s or circle\u0027s origin.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "width": {
                  "description": "A rectangle\u0027s width.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "height": {
                  "description": "A rectangle\u0027s height.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "r": {
                  "description": "A circle\u0027s radius.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "from": {
                  "description": "A line\u0027s start.",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                },
                "to": {
                  "description": "A line\u0027s end.",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                },
                "points": {
                  "description": "A polyline\u0027s or polygon\u0027s points, flattened [x0, y0, x1, y1, \u2026].",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                },
                "fill": {
                  "description": "What fills a closed shape: state for the active colour scale\u0027s slot (57), stroke for a solid mark in the line colour; absent for an outline.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dashed": {
                  "description": "true for a dashed stroke; absent for a solid one.",
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "portAnchors": {
            "description": "The default arrangement: each named port\u0027s anchor on the box edge and its outward direction.",
            "type": "object",
            "additionalProperties": {
              "title": "Anchor",
              "description": "Where a port meets its symbol, and which way a connection leaves it.",
              "type": "object",
              "properties": {
                "at": {
                  "description": "The point on the box edge, [x, y] in symbol units.",
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "direction": {
                  "description": "The outward unit vector a connection leaves along, [dx, dy] with y up (28 A1); rotates with the box. Absent for the wildcard anchor, whose direction the layout chooses.",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "at"
              ]
            }
          },
          "alternatives": {
            "description": "Other complete arrangements of the same ports on the same box, by name; the renderer may pick one per instance, with a rotation, to shorten the connections it has to draw. Absent when there is one.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/properties/symbols/items/properties/portAnchors/additionalProperties"
              }
            }
          },
          "indexedPortAnchors": {
            "description": "Rules for indexed ports such as a tank\u0027s in{n}; absent for a fixed-port symbol.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "title": "IndexedAnchor",
              "description": "An anchor rule for an indexed port family.",
              "type": "object",
              "properties": {
                "prefix": {
                  "description": "The port name prefix, in or out.",
                  "type": "string"
                },
                "side": {
                  "description": "The box side the family sits on.",
                  "type": "string"
                },
                "direction": {
                  "description": "The outward unit vector every anchor of the family leaves along, [dx, dy].",
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "verticalCoordinate": {
                  "description": "Which port field gives the position along that side.",
                  "type": "string"
                },
                "minIndex": {
                  "description": "The smallest index the rule covers.",
                  "type": "integer"
                },
                "maxIndex": {
                  "description": "The largest index the rule covers.",
                  "type": "integer"
                }
              },
              "required": [
                "prefix",
                "side",
                "direction",
                "verticalCoordinate",
                "minIndex",
                "maxIndex"
              ]
            }
          },
          "labelAnchor": {
            "description": "Where the label sits, [x, y].",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "transformClass": {
            "description": "Which transforms the kind admits (28 A4, D-108): free turns by any quarter, mirrored or not; standing is never turned, only mirrored left-right, up-down or both (every exchanger); upright admits only the left-right mirror (a tank, whose layers are a vertical order); level admits every transform but stands vertical only where nothing level fits (a pump, D-113). A fact about the kind, never a preference.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "viewBox",
          "primitives",
          "portAnchors",
          "labelAnchor"
        ]
      }
    },
