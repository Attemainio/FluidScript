                "minIndex": {
                  "description": "The lowest index.",
                  "type": "integer"
                },
                "maxIndex": {
                  "description": "The highest index, or null when another parameter sets it.",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "maxIndexParameter": {
                  "description": "The parameter that sets the highest index, or null.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "element": {
                  "title": "ParameterMeta",
                  "description": "What each member of the family is.",
                  "type": "object",
                  "properties": {
                    "name": {
                      "description": "The canonical name.",
                      "type": "string"
                    },
                    "aliases": {
                      "description": "Other spellings the binder accepts.",
                      "$ref": "#/properties/kinds/items/properties/parameters/items/properties/aliases"
                    },
                    "valueKind": {
                      "description": "quantity, symbol or reference.",
                      "type": "string"
                    },
                    "dimension": {
                      "description": "The dimension\u0027s name, an entry in Dimensions; null for a synthesised dimension such as W/(m\u00B2\u00B7K), which Unit alone names.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "description": "The unit a bare number means and values are reported in, or null for a dimensionless parameter.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "acceptedSymbols": {
                      "description": "The symbols a symbol-valued parameter accepts, such as a valve characteristic.",
                      "$ref": "#/properties/kinds/items/properties/parameters/items/properties/acceptedSymbols"
                    },
                    "omission": {
                      "description": "What omitting it means: size, default or require (D-02).",
                      "type": "string"
                    },
                    "default": {
                      "description": "The default as the script would write it, when the omission policy is default.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "defaultBasis": {
                      "description": "Why that default, in the registry\u0027s words.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "usualRange": {
                      "description": "The range a stated value usually falls in, or null.",
                      "$ref": "#/properties/kinds/items/properties/parameters/items/properties/usualRange"
                    },
                    "validRange": {
                      "description": "The range outside which a stated value is an error, or null.",
                      "$ref": "#/properties/kinds/items/properties/parameters/items/properties/validRange"
                    },
                    "wholeNumber": {
                      "description": "Whether a stated value must be a whole number.",
                      "type": "boolean"
                    },
                    "displayPrecision": {
                      "description": "Significant digits a display shows.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "name",
                    "aliases",
                    "valueKind",
                    "dimension",
                    "unit",
                    "acceptedSymbols",
                    "omission",
                    "default",
                    "defaultBasis",
                    "usualRange",
                    "validRange",
                    "wholeNumber",
                    "displayPrecision"
                  ]
                }
              },
              "required": [
                "pattern",
                "minIndex",
                "maxIndex",
                "maxIndexParameter",
                "element"
              ]
            }
