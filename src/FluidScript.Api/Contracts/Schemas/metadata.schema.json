                },
                "maxIndex": {
                  "description": "The highest index, or null when another parameter sets it.",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "maxIndexParameter": {
                  "description": "The parameter that sets the highest index, or null.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "element": {
                  "title": "PropertyMeta",
                  "description": "What each member of the family is.",
                  "type": "object",
                  "properties": {
                    "name": {
                      "description": "The name after the dot in an expression.",
                      "type": "string"
                    },
                    "dimension": {
                      "description": "The dimension\u0027s name.",
