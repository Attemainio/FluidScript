# Layout stress plant (2026-09-24): a heating plant much larger than any ladder step, drawn to see where
# the layout breaks. Two boilers in parallel charge a buffer tank; duty/standby pumps draw from it into a
# radiator header whose return feeds, in series, a second header of injection circuits (AHU, floor) and
# a two-sided DHW exchanger with its own tank and circulation. Layout only -- no gate reads this folder,
# and it is not claimed to solve. Composed engine hard 28 soft 98, ladder engine hard 39 soft 110:
# C-129 (a component shared by two cycles), C-130, C-131, C-132. Pieces: plant-production,
# plant-distribution, plant-distribution-dhw.

fluidscript 1
project static plant_big

circuit production 100
fluid water

B1     heat_exchanger power=150 kW out.t=75
B2     heat_exchanger power=150 kW out.t=75
PU_B1  pump
PU_B2  pump
CV_B1  valve kv=16
CV_B2  valve kv=16
T1     tank volume=2000 layers=5 in.level=90% in[2].level=10% out.level=90% out[2].level=10%

connections
T1.out[2] - NB_S
NB_S - PU_B1 - B1 - CV_B1 - NB_M
NB_S - PU_B2 - B2 - CV_B2 - NB_M
NB_M - T1.in

circuit distribution 101
fluid water

PU_S1  pump
PU_S2  pump
CV_S1  valve kv=25
CV_S2  valve kv=25
BV1    valve kv=40
CV_R1  valve kv=4
CV_R2  valve kv=4
CV_R3  valve kv=4
RAD1   load in.t=70 out.t=50 power=40 kW
RAD2   load in.t=70 out.t=50 power=35 kW
RAD3   load in.t=70 out.t=50 power=25 kW

connections
T1.out - NP_S
NP_S - PU_S1 - CV_S1 - NP_M
NP_S - PU_S2 - CV_S2 - NP_M
NP_M - BV1 - NA1
NA1 - CV_R1 - RAD1 - NR1 - NRB1
NA1 - NA2
NA2 - CV_R2 - RAD2 - NR2 - NRB2
NA2 - CV_R3 - RAD3 - NR3 - NRB2
NRB2 - NRB1
NRB1 - NC1

circuit AHU 102

HE_AHU  load in.t=45 out.t=30 power=60 kW
TV_AHU  three_way_valve
PU_AHU  pump

connections
NC1 - TV_AHU.a length=12 dn=40
NM_AHU - TV_AHU.b
TV_AHU.ab - PU_AHU - HE_AHU - NM_AHU
NM_AHU - ND1 length=12 dn=40

circuit floor 103

HE_FLR  load in.t=35 out.t=28 power=40 kW
TV_FLR  three_way_valve
PU_FLR  pump

connections
NC1 - NC2
NC2 - TV_FLR.a length=15 dn=32
NM_FLR - TV_FLR.b
TV_FLR.ab - PU_FLR - HE_FLR - NM_FLR
NM_FLR - ND2 length=15 dn=32

circuit dhw 104

HX_DHW   heat_exchanger power=50 kW in.t=10 out.t=60 in[2].t=50 out[2].t=25
T2       tank volume=500 layers=3 in.level=90% in[2].level=50% out.level=90%
PU_DHW   pump
PU_CIRC  pump
CV_CIRC  valve kv=1.6
CW       inlet t=10 p=300
TAP      outlet p=250

connections
NC2 - HX_DHW.in[2]
HX_DHW.out[2] - ND2
ND2 - ND1
ND1 - T1.in[2]
CW - PU_DHW - HX_DHW.in
HX_DHW.out - T2.in
T2.out - NDS
NDS - TAP
NDS - PU_CIRC - CV_CIRC - T2.in[2]
