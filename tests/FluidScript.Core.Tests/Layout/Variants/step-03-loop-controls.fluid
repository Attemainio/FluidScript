# Step 3 with its controls (a variant beside the ladder, P6.10): the supply and return are measured,
# and the pump holds the return temperature -- its constant-temperature mode -- in place of the
# exchanger's stated inlet.

fluidscript 2

circuit "ladder":
  fluid = water

  PU1  pump
  HE1  heat_exchanger  power = 30  out.t = 50
  TE_S  t_sensor at NS
  TE_R  t_sensor at NR
  TC1 controller:
    kp = 2
    moves = PU1
    reads = TE_R
    setpoint = 20
  LOAD  heat_exchanger  power = -30

  PU1 - HE1
  HE1 - NS - LOAD
  LOAD - NR - PU1
