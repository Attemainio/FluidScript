# Step 5 with its controls (a variant beside the ladder, P6.10): the secondary valve holds the
# secondary supply in place of the exchanger's stated outlet, as step 10 does, and the primary return
# is measured at its terminal.

fluidscript 2

circuit "ladder":
  fluid = water

  NPS  inlet  t = 85  p = 600
  NPR  outlet  p = 350
  PCV  valve

  PU1  pump
  HE1  heat_exchanger  power = 30  primary.in.t = 20  secondary.in.t = 85  secondary.out.t = 45
  TE_S  t_sensor at NS
  TE_P  t_sensor at NPR
  TC1 controller:
    kp = 2
    moves = CV1
    reads = TE_S
    setpoint = 50
  LOAD  heat_exchanger  power = -30
  CV1  valve

  NPS - PCV
  PCV - HE1.secondary.in   12 m  DN25
  HE1.secondary.out - NPR

  PU1 - HE1.primary.in
  HE1.primary.out - NS - LOAD
  LOAD - CV1
  CV1 - PU1
