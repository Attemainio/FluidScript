# does not settle: S-86 -- the flow seed never reads the setpoint, so the loop seeds at the nominal flow.
# Step 8c with its controls (P6.10; a ladder step at the switch): each mixing loop holds its
# secondary supply by driving its three-way valve, in place of the coil's stated inlet, and the primary
# supply and return are measured.

fluidscript 1
project static plant_01

circuit heating 100
fluid water

HS1     heat_exchanger power=30 kW out.t=60
TE_S    t_sensor at NS
TE_R    t_sensor at NR

connections
N1 - HS1 - NS - N3
N7 - NR - N1

N1 node p=250

circuit radiators 102

HE_RAD  load out.t=40 power=20 kW
TV_RAD  three_way_valve
PU_RAD  pump
TE_RAD  t_sensor at NT_RAD
TC_RAD  pid kp=2

connections
N3 - TV_RAD.a length=18 dn=25
NM_RAD - TV_RAD.b
TV_RAD.ab - PU_RAD - NT_RAD - HE_RAD - NM_RAD
NM_RAD - N4 length=18 dn=25

control TV_RAD with TE_RAD by TC_RAD setpoint=50

circuit AHU 101

HE_AHU  load out.t=36
TV_AHU  three_way_valve
PU_AHU  pump
TE_AHU  t_sensor at NT_AHU
TC_AHU  pid kp=2

connections
N4 - TV_AHU.a length=12 dn=25
NM_AHU - TV_AHU.b
TV_AHU.ab - PU_AHU - NT_AHU - HE_AHU - NM_AHU
NM_AHU - N5 length=12 dn=25

control TV_AHU with TE_AHU by TC_AHU setpoint=38

circuit floor 103

HE_FLR  load out.t=33
TV_FLR  three_way_valve
PU_FLR  pump
TE_FLR  t_sensor at NT_FLR
TC_FLR  pid kp=2

connections
N5 - TV_FLR.a length=15 dn=25
NM_FLR - TV_FLR.b
TV_FLR.ab - PU_FLR - NT_FLR - HE_FLR - NM_FLR
NM_FLR - N6 length=15 dn=25

control TV_FLR with TE_FLR by TC_FLR setpoint=34.5

circuit dhw 104

HE_DHW  load out.t=30
TV_DHW  three_way_valve
PU_DHW  pump
TE_DHW  t_sensor at NT_DHW
TC_DHW  pid kp=2

connections
N6 - TV_DHW.a length=10 dn=25
NM_DHW - TV_DHW.b
TV_DHW.ab - PU_DHW - NT_DHW - HE_DHW - NM_DHW
NM_DHW - N7 length=10 dn=25

control TV_DHW with TE_DHW by TC_DHW setpoint=31.5
