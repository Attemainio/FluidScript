# does not bind: C-93 -- two independent circuits in one project are refused as one disconnected circuit.
# Layout ladder, step 11b (plan/20-core-domain/29-layout-ladder.md): the syntax tour's first two
# circuits verbatim, its own spacing kept. The cooling loop declares a pump that nothing connects
# and leaves a port open to a terminating node; the expressions circuit is a chain between two
# boundaries with a three-way valve fed by a second pair. What the file states, it states for the
# lexer, not the plant: the solve gate marks it as it marks step 11a.

fluidscript 2

project "plant_01":
  spacing = 0.75
  # no mode stated: the project's default decides (D-37)
  catalog = steel_en10255  # the shipped series, version unpinned
  # a lone `-` is the solid pattern
  show = [temperature, pressure]  # two properties and an explicit scale range
  scale = 0..40

let dT = 30 K  # a unit may be separated from its number (rule 5)
let cp = 4.18 kJ/(kg*K)  # one atomic unit symbol, never four tokens
let Q = 30 kW
let mdot = Q / (cp * dT)  # the same `/` and `*`, now operators: no number precedes
let peak = max(Q, 24 kW)  # a call, and the only comma in the language
let margin = peak + 2 kW
let droop = -2 K  # unary minus
let share = 50 %  # `%` is a unit symbol and never an operator (D-51)
let scale = 1.2e3  # exponent form, and a bare number
let bore = 27.3 mm  # DN25 steel bore: a designation is not a diameter

circuit "coolingLoop":  # R-01: declarative block
  fluid = water
  role = cooling
  style:
    colour = blue
    width = 2
    corner = fillet
    line = dashed

  # R-12: `dynamic` selects the transient model
  # R-26: presentation is in the script, not a side file

  HE1  heat_exchanger  power = 30  in.t = 20  out.t = 50  # R-04: 30 kW, 20 °C, 50 °C by parameter kind
  3WV  three_way_valve  # R-02: no parameters at all — size it
  PU1  pump  # R-02 + R-14: head derived from the loop it sits in

  N1 - N2  # R-06: N1 and N2 are never declared; they are inferred
  N2 - HE1
  HE1 - 3WV.ab
  3WV.a - N2
  3WV.b - N3  # R-06: N3 is an open port; it gets a terminating node

# ---------------------------------------------------------------------------------------------
# Expressions, units, and the productions the reference does not reach. The header below sits under
# a `connections` section and ends it: sections are scoped to a circuit (D-52).
# ---------------------------------------------------------------------------------------------

circuit "expressions":
  fluid = water
  number = 200
  style:
    colour = gray
    width = 1
    corner = sharp
    line = solid

  HE2  load  in.t = 50  out.t = 30  power = Q  # a parameter whose value is a reference to a `let`
  TV2  three_way_valve  characteristic = equal_percentage  authority = 0.5  # a symbol, bound not evaluated
  NB1  inlet  t = 6  p = 300  # mass crosses here, so it says so (D-64). A `p=` on a
  NB2  outlet  p = 280  # plain `node` is a *datum* instead, and admits none (D-86)
  SB1  inlet  t = 6  flow = 0.24 kg/s  # `inlet` in kind position: a boundary that says so (D-64)
  RB1  outlet  # and `outlet`, which needs no arguments at all

  NB1 - NJ1  # a boundary has one connection (D-115): the split is NJ1's
  NJ1 - HE2
  HE2 - NJ2   25 m  # properties on the line make the pipe (I7, D-110)
  NJ2 - NB2  # and the merge before the outlet is NJ2's
  SB1 - TV2  # a port-qualified endpoint: the second inlet into port a
  NJ1 - TV2  # the first inlet's water taps into port b
  TV2 - RB1  # and the declared outlet takes the mixed stream away

run "Transient":
  steady = ["expressions"]

# ---------------------------------------------------------------------------------------------
# A subcircuit: attachment to the parent, a controller, and a control binding.
# ---------------------------------------------------------------------------------------------
