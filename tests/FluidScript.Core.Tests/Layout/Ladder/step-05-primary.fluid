# Layout ladder, step 5 (plan/20-core-domain/29-layout-ladder.md): the primary on the exchanger's second side.

fluidscript 2

circuit "ladder":
  fluid = water

  NPS  inlet  t = 85  p = 600
  NPR  outlet  p = 350
  PCV  valve

  PU1  pump
  HE1  heat_exchanger  power = 30  primary.in.t = 20  primary.out.t = 50  secondary.in.t = 85  secondary.out.t = 45
  LOAD  heat_exchanger  power = -30
  CV1  valve

  NPS - PCV
  PCV - HE1.secondary.in   12 m  DN25
  HE1.secondary.out - NPR

  PU1 - HE1.primary.in
  HE1.primary.out - LOAD
  LOAD - CV1
  CV1 - PU1
