# Layout ladder, step 12b (29, C-128): step 12 with its instruments.
# Each zone valve holds its return temperature, the pump holds the pressure at the index point, and a
# flow meter reads the supply.

fluidscript 2

circuit "zones":
  fluid = water

  PU1  pump
  HE1  heat_exchanger  power = 60  out.t = 70
  CV1  valve  kv = 4
  CV2  valve  kv = 4
  CV3  valve  kv = 4
  LD1  heat_exchanger  power = -20
  LD2  heat_exchanger  power = -20
  LD3  heat_exchanger  power = -20
  TC1 controller:
    kp = 2
    moves = CV1
    reads = TE1
    setpoint = 40
  TC2 controller:
    kp = 2
    moves = CV2
    reads = TE2
    setpoint = 40
  TC3 controller:
    kp = 2
    moves = CV3
    reads = TE3
    setpoint = 40
  PC1 controller:
    kp = 1
    moves = PU1
    reads = PE1
    setpoint = 150
  TE1  t_sensor at NR1
  TE2  t_sensor at NR2
  TE3  t_sensor at NR3
  PE1  p_sensor at NP
  FE1  flow_sensor at NS

  PU1 - HE1
  HE1 - NS
  NS - NA1
  NA1 - CV1 - LD1 - NR1 - NB1
  NA1 - NA2
  NA2 - CV2 - LD2 - NR2 - NB2
  NA2 - CV3 - LD3 - NR3 - NB2
  NB2 - NB1
  NB1 - NP
  NP - PU1
