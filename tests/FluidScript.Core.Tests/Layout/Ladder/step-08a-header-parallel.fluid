# Layout ladder, step 8a (plan/20-core-domain/29-layout-ladder.md): the distribution header with
# its two injection branches in parallel -- the m2-distribution-header sample's circuits verbatim,
# the header's own comments left out. Two blocks of one shape must draw alike, side by side
# between the supply and return headers, in script order.

fluidscript 1
project static plant_01

circuit heating 100
fluid water

HS1     heat_exchanger power=54 kW out=60

connections
N1 - HS1 - N3
N3 - N4
N6 - N5
N5 - N1

N1 node p=250

circuit AHU 101

HE_AHU  load in=50 out=30 power=24 kW
TV_AHU  three_way_valve
PU_AHU  pump
PA1     pipe length=12 dn=25
PA2     pipe length=12 dn=25

connections
N3 - PA1 - TV_AHU.a
NM_AHU - TV_AHU.b
TV_AHU.ab - PU_AHU - HE_AHU - NM_AHU
NM_AHU - PA2 - N5

circuit radiators 102

HE_RAD  load in=50 out=30 power=30 kW
TV_RAD  three_way_valve
PU_RAD  pump
PR1     pipe length=18 dn=25
PR2     pipe length=18 dn=25

connections
N4 - PR1 - TV_RAD.a
NM_RAD - TV_RAD.b
TV_RAD.ab - PU_RAD - HE_RAD - NM_RAD
NM_RAD - PR2 - N6
