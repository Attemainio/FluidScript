# does not settle: S-63 -- the solve gate records the report and expects the stall until the defect closes.
# Layout ladder, step 8c (plan/20-core-domain/29-layout-ladder.md): four injection branches in
# series on one ring. The radiators take 20 kW at 50/40 from the 60 C supply and fix the ring's
# stream at 0.239 kg/s; the next three loads cool that stream 40 -> 36 -> 33 -> 30 with their duties
# sized (4, 3 and 3 kW), and HS1 states the total 30 kW. N4, N5 and N6 each join one branch's return
# to the next branch's supply and, with two connections, are inline (D-114).

fluidscript 1
project static plant_01

circuit heating 100
fluid water

HS1     heat_exchanger power=30 kW out=60

connections
N1 - HS1 - N3
N7 - N1

N1 node p=250

circuit radiators 102

HE_RAD  load in=50 out=40 power=20 kW
TV_RAD  three_way_valve
PU_RAD  pump
PR1     pipe length=18 dn=25
PR2     pipe length=18 dn=25

connections
N3 - PR1 - TV_RAD.a
NM_RAD - TV_RAD.b
TV_RAD.ab - PU_RAD - HE_RAD - NM_RAD
NM_RAD - PR2 - N4

circuit AHU 101

HE_AHU  load in=40 out=36
TV_AHU  three_way_valve
PU_AHU  pump
PA1     pipe length=12 dn=25
PA2     pipe length=12 dn=25

connections
N4 - PA1 - TV_AHU.a
NM_AHU - TV_AHU.b
TV_AHU.ab - PU_AHU - HE_AHU - NM_AHU
NM_AHU - PA2 - N5

circuit floor 103

HE_FLR  load in=36 out=33
TV_FLR  three_way_valve
PU_FLR  pump
PF1     pipe length=15 dn=25
PF2     pipe length=15 dn=25

connections
N5 - PF1 - TV_FLR.a
NM_FLR - TV_FLR.b
TV_FLR.ab - PU_FLR - HE_FLR - NM_FLR
NM_FLR - PF2 - N6

circuit dhw 104

HE_DHW  load in=33 out=30
TV_DHW  three_way_valve
PU_DHW  pump
PD1     pipe length=10 dn=25
PD2     pipe length=10 dn=25

connections
N6 - PD1 - TV_DHW.a
NM_DHW - TV_DHW.b
TV_DHW.ab - PU_DHW - HE_DHW - NM_DHW
NM_DHW - PD2 - N7
