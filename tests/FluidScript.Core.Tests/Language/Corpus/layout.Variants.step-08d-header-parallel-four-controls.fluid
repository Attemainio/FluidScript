# Step 8d with its controls (a variant beside the ladder, P6.10): each mixing loop holds its
# secondary supply by driving its three-way valve, in place of the coil's stated inlet, and the primary
# supply and return are measured.

fluidscript 2

project "plant_01":
circuit "heating":
  fluid = water
  number = 100
  role = heating

  HS1  heat_exchanger  power = 84 kW  out.t = 60
  TE_S  t_sensor at NS
  TE_R  t_sensor at NR

  N1 - HS1 - NS - N3
  N3 - N4
  N4 - N5
  N5 - N6
  N10 - N9
  N9 - N8
  N8 - N7
  N7 - NR - N1

  N1  node  p = 250

circuit "radiators":
  number = 102
  role = radiator

  HE_RAD  load  out.t = 30  power = 30 kW
  TV_RAD  three_way_valve
  PU_RAD  pump
  TE_RAD  t_sensor at NT_RAD
  TC_RAD controller:
    kp = 2
    moves = TV_RAD
    reads = TE_RAD
    setpoint = 50

  N3 - TV_RAD   18 m  DN25
  NM_RAD - TV_RAD
  TV_RAD - PU_RAD - NT_RAD - HE_RAD - NM_RAD
  NM_RAD - N7   18 m  DN25

circuit "AHU":
  number = 101
  role = ahu

  HE_AHU  load  out.t = 30  power = 24 kW
  TV_AHU  three_way_valve
  PU_AHU  pump
  TE_AHU  t_sensor at NT_AHU
  TC_AHU controller:
    kp = 2
    moves = TV_AHU
    reads = TE_AHU
    setpoint = 50

  N4 - TV_AHU   12 m  DN25
  NM_AHU - TV_AHU
  TV_AHU - PU_AHU - NT_AHU - HE_AHU - NM_AHU
  NM_AHU - N8   12 m  DN25

circuit "floor":
  number = 103

  HE_FLR  load  out.t = 30  power = 18 kW
  TV_FLR  three_way_valve
  PU_FLR  pump
  TE_FLR  t_sensor at NT_FLR
  TC_FLR controller:
    kp = 2
    moves = TV_FLR
    reads = TE_FLR
    setpoint = 50

  N5 - TV_FLR   15 m  DN25
  NM_FLR - TV_FLR
  TV_FLR - PU_FLR - NT_FLR - HE_FLR - NM_FLR
  NM_FLR - N9   15 m  DN25

circuit "dhw":
  number = 104
  role = hot_water

  HE_DHW  load  out.t = 30  power = 12 kW
  TV_DHW  three_way_valve
  PU_DHW  pump
  TE_DHW  t_sensor at NT_DHW
  TC_DHW controller:
    kp = 2
    moves = TV_DHW
    reads = TE_DHW
    setpoint = 50

  N6 - TV_DHW   10 m  DN25
  NM_DHW - TV_DHW
  TV_DHW - PU_DHW - NT_DHW - HE_DHW - NM_DHW
  NM_DHW - N10   10 m  DN25
