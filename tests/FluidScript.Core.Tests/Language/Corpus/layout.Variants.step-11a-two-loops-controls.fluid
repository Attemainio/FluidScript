# does not settle: S-93 -- PU_H is sized to the loop with CV_H fully open at the seeded flow, so CV_H pins open.
# Step 11a with its controls (a variant beside the ladder, P6.10): the heating valve holds the
# heating supply in place of the source's stated outlet, as step 10 does, and the cooling loop's
# three-way valve holds the mixed supply into its exchanger in place of its stated inlet.

fluidscript 2

project "plant_01":
circuit "heating":
  fluid = water
  number = 100
  role = heating

  PU_H  pump
  HS_H  heat_exchanger  power = 30  in.t = 20
  TE_H  t_sensor at NH
  TC_H controller:
    kp = 2
    moves = CV_H
    reads = TE_H
    setpoint = 50
  LOAD  heat_exchanger  power = -30
  CV_H  valve  kv = 6.3

  PU_H - HS_H
  HS_H - NH - LOAD
  LOAD - CV_H
  CV_H - PU_H

circuit "cooling":
  fluid = water
  number = 101
  role = cooling

  HE_C  heat_exchanger  power = 30  out.t = 50
  TE_C  t_sensor at NC
  TC_C controller:
    kp = 2
    moves = TV_C
    reads = TE_C
    setpoint = 20
  TV_C  three_way_valve
  PU_C  pump

  N1 - N2
  N2 - NC - PU_C
  PU_C - HE_C
  HE_C - TV_C
  TV_C - N2
  TV_C - N3   25 m  DN25

  N1  inlet  t = 6  p = 300
  N3  outlet  p = 280
