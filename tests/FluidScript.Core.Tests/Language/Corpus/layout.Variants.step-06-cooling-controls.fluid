# Step 6 with its controls (a variant beside the ladder, P6.10): the three-way valve holds the
# mixed supply into the exchanger in place of its stated inlet.

fluidscript 2

circuit "coolingLoop":
  fluid = water
  role = cooling

  HE1  heat_exchanger  power = 30  out.t = 50
  TE1  t_sensor at NM
  TC1 controller:
    kp = 2
    moves = 3WV
    reads = TE1
    setpoint = 20
  3WV  three_way_valve
  PU1  pump

  N1 - N2
  N2 - NM - PU1
  PU1 - HE1
  HE1 - 3WV
  3WV - N2
  3WV - N3   25 m  DN25

  N1  inlet  t = 6  p = 300
  N3  outlet  p = 280
