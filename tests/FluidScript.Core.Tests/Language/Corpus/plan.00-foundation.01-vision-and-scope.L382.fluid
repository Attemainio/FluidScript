fluidscript 2

project:
  show = temperature

circuit "substation":
  fluid = water

  # --- district-heating primary, 85/45 -------------------------------
  NPS  inlet  t = 85  p = 600
  NPR  outlet  p = 350
  PCV  valve

  # --- heating secondary, 40/60 --------------------------------------
  SP  pump
  LOAD  heat_exchanger  power = -150  dt = 20

  # --- the exchanger between them ------------------------------------
  HX1  heat_exchanger  power = 150  primary.in.t = 40  primary.out.t = 60  secondary.in.t = 85  secondary.out.t = 45  u = 3300

  NPS - PCV
  PCV - HX1.secondary.in   12 m
  HX1.secondary.out - NPR

  HX1.primary.out - NSUP   30 m
  NSUP - LOAD - NRET
  NRET - SP   30 m
  SP - HX1.primary.in
