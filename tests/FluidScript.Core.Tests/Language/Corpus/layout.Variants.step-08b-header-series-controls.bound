project plant_01 cases [] design  start 
style spacing  default StyleSpec { Stroke = , StrokeWidth = , Corner = , Pattern = , Fill = , IsEmpty = True }
circuit heating 100 water heating
circuit radiators 102  radiator
circuit AHU 101  ahu
component HE_AHU heat_exchanger in AHU at  tag 101HE01 style 
  out = 303.15 Temperature  
component HE_RAD heat_exchanger in radiators at  tag 102HE01 style 
  out = 313.15 Temperature  
  power = 20000 Power  
component HS1 heat_exchanger in heating at  tag 100HE01 style 
  out = 333.15 Temperature  
  power = 30000 Power  
component N1 node in heating at  tag  style 
  p = 250000 Pressure  
component N3 node in heating at  tag  style 
component N3__TV_RAD pipe in radiators at  tag  style 
  dn = 25 NominalDiameter  
  length = 18 Length  
component N3__TV_RAD__out node in radiators at  tag  style 
component N4 node in radiators at  tag  style 
component N4__TV_AHU pipe in AHU at  tag  style 
  dn = 25 NominalDiameter  
  length = 12 Length  
component N4__TV_AHU__out node in AHU at  tag  style 
component N5 node in heating at  tag  style 
component NM_AHU node in AHU at  tag  style 
component NM_AHU__N5 pipe in AHU at  tag  style 
  dn = 25 NominalDiameter  
  length = 12 Length  
component NM_RAD node in radiators at  tag  style 
component NM_RAD__N4 pipe in radiators at  tag  style 
  dn = 25 NominalDiameter  
  length = 18 Length  
component NR node in heating at  tag  style 
component NS node in heating at  tag  style 
component NT_AHU node in AHU at  tag  style 
component NT_RAD node in radiators at  tag  style 
component PU_AHU pump in AHU at  tag 101PU01 style 
component PU_RAD pump in radiators at  tag 102PU01 style 
component TC_AHU controller in AHU at  tag 101PID01 style 
  kp = 2 Dimensionless  
component TC_RAD controller in radiators at  tag 102PID01 style 
  kp = 2 Dimensionless  
component TE_AHU t_sensor in AHU at NT_AHU tag 101TE01 style 
component TE_M t_sensor in radiators at N4 tag 102TE02 style 
component TE_R t_sensor in heating at NR tag 100TE02 style 
component TE_RAD t_sensor in radiators at NT_RAD tag 102TE01 style 
component TE_S t_sensor in heating at NS tag 100TE01 style 
component TV_AHU three_way_valve in AHU at  tag 101TV01 style 
component TV_AHU__PU_AHU node in AHU at  tag  style 
component TV_RAD three_way_valve in radiators at  tag 102TV01 style 
component TV_RAD__PU_RAD node in radiators at  tag  style 
connection HE_AHU.out -> NM_AHU.
connection HE_RAD.out -> NM_RAD.
connection HS1.out -> NS.
connection N1. -> HS1.in
connection N3. -> N3__TV_RAD.in
connection N3__TV_RAD.out -> N3__TV_RAD__out.
connection N3__TV_RAD__out. -> TV_RAD.a
connection N4. -> N4__TV_AHU.in
connection N4__TV_AHU.out -> N4__TV_AHU__out.
connection N4__TV_AHU__out. -> TV_AHU.a
connection N5. -> NR.
connection NM_AHU. -> NM_AHU__N5.in
connection NM_AHU. -> TV_AHU.b
connection NM_AHU__N5.out -> N5.
connection NM_RAD. -> NM_RAD__N4.in
connection NM_RAD. -> TV_RAD.b
connection NM_RAD__N4.out -> N4.
connection NR. -> N1.
connection NS. -> N3.
connection NT_AHU. -> HE_AHU.in
connection NT_RAD. -> HE_RAD.in
connection PU_AHU.out -> NT_AHU.
connection PU_RAD.out -> NT_RAD.
connection TV_AHU.ab -> TV_AHU__PU_AHU.
connection TV_AHU__PU_AHU. -> PU_AHU.in
connection TV_RAD.ab -> TV_RAD__PU_RAD.
connection TV_RAD__PU_RAD. -> PU_RAD.in
control TC_AHU moves PropertyReference { Component = TV_AHU, Property = position } reads PropertyReference { Component = TE_AHU, Property = t } setpoint 308.15 Temperature [] band - differential - output -..- curve 
control TC_RAD moves PropertyReference { Component = TV_RAD, Property = position } reads PropertyReference { Component = TE_RAD, Property = t } setpoint 323.15 Temperature [] band - differential - output -..- curve 
