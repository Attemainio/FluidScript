# Step 7 with its controls (a variant beside the ladder, P6.10): each mixing loop holds its
# secondary supply by driving its three-way valve, in place of the coil's stated inlet, and the primary
# supply and return are measured.

fluidscript 2

project "plant_01":
circuit "heating":
  fluid = water
  number = 100
  role = heating

  HS1  heat_exchanger  power = 24 kW  out.t = 60
  TE_S  t_sensor at NS
  TE_R  t_sensor at NR

  N1 - HS1 - NS - N3
  N5 - NR - N1

  N1  node  p = 250

circuit "AHU":
  number = 101
  role = ahu

  HE_AHU  load  out.t = 30  power = 24 kW
  TV_AHU  three_way_valve
  PU_AHU  pump
  TE_AHU  t_sensor at NT_AHU
  TC_AHU controller:
    kp = 2
    moves = TV_AHU
    reads = TE_AHU
    setpoint = 50

  N3 - TV_AHU   12 m  DN25
  NM_AHU - TV_AHU
  TV_AHU - PU_AHU - NT_AHU - HE_AHU - NM_AHU
  NM_AHU - N5   12 m  DN25
