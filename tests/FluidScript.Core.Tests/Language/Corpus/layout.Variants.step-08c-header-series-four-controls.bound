connection NM_RAD__N4.out -> N4.
connection NR. -> N1.
connection NS. -> N3.
connection NT_AHU. -> HE_AHU.in
connection NT_DHW. -> HE_DHW.in
connection NT_FLR. -> HE_FLR.in
connection NT_RAD. -> HE_RAD.in
connection PU_AHU.out -> NT_AHU.
connection PU_DHW.out -> NT_DHW.
connection PU_FLR.out -> NT_FLR.
connection PU_RAD.out -> NT_RAD.
connection TV_AHU.ab -> TV_AHU__PU_AHU.
connection TV_AHU__PU_AHU. -> PU_AHU.in
connection TV_DHW.ab -> TV_DHW__PU_DHW.
connection TV_DHW__PU_DHW. -> PU_DHW.in
connection TV_FLR.ab -> TV_FLR__PU_FLR.
connection TV_FLR__PU_FLR. -> PU_FLR.in
connection TV_RAD.ab -> TV_RAD__PU_RAD.
connection TV_RAD__PU_RAD. -> PU_RAD.in
control TC_AHU moves PropertyReference { Component = TV_AHU, Property = position } reads PropertyReference { Component = TE_AHU, Property = t } setpoint 311.15 Temperature [] band - differential - output -..- curve 
control TC_DHW moves PropertyReference { Component = TV_DHW, Property = position } reads PropertyReference { Component = TE_DHW, Property = t } setpoint 304.65 Temperature [] band - differential - output -..- curve 
control TC_FLR moves PropertyReference { Component = TV_FLR, Property = position } reads PropertyReference { Component = TE_FLR, Property = t } setpoint 307.65 Temperature [] band - differential - output -..- curve 
control TC_RAD moves PropertyReference { Component = TV_RAD, Property = position } reads PropertyReference { Component = TE_RAD, Property = t } setpoint 323.15 Temperature [] band - differential - output -..- curve 
