# Step 8b with its controls (a variant beside the ladder, P6.10): each mixing loop holds its secondary
# supply temperature by driving its three-way valve; the primary supply, the stream between the two
# loops and the return are measured.

fluidscript 2

project "plant_01":
circuit "heating":
  fluid = water
  number = 100
  role = heating

  HS1  heat_exchanger  power = 30 kW  out.t = 60
  TE_S  t_sensor at NS
  TE_R  t_sensor at NR

  N1 - HS1 - NS - N3
  N5 - NR - N1

  N1  node  p = 250

circuit "radiators":
  number = 102
  role = radiator

  HE_RAD  load  out.t = 40  power = 20 kW
  TV_RAD  three_way_valve
  PU_RAD  pump
  TE_RAD  t_sensor at NT_RAD
  TC_RAD controller:
    kp = 2
    moves = TV_RAD
    reads = TE_RAD
    setpoint = 50
  TE_M  t_sensor at N4

  N3 - TV_RAD   18 m  DN25
  NM_RAD - TV_RAD
  TV_RAD - PU_RAD - NT_RAD - HE_RAD - NM_RAD
  NM_RAD - N4   18 m  DN25

circuit "AHU":
  number = 101
  role = ahu

  HE_AHU  load  out.t = 30
  TV_AHU  three_way_valve
  PU_AHU  pump
  TE_AHU  t_sensor at NT_AHU
  TC_AHU controller:
    kp = 2
    moves = TV_AHU
    reads = TE_AHU
    setpoint = 35

  N4 - TV_AHU   12 m  DN25
  NM_AHU - TV_AHU
  TV_AHU - PU_AHU - NT_AHU - HE_AHU - NM_AHU
  NM_AHU - N5   12 m  DN25
