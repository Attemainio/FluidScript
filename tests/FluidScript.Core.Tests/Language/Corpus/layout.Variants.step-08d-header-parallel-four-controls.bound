  dn = 25 NominalDiameter  
  length = 10 Length  
component N6__TV_DHW__out node in dhw at  tag  style 
component N7 node in heating at  tag  style 
component N8 node in heating at  tag  style 
component N9 node in heating at  tag  style 
component NM_AHU node in AHU at  tag  style 
component NM_AHU__N8 pipe in AHU at  tag  style 
  dn = 25 NominalDiameter  
  length = 12 Length  
component NM_DHW node in dhw at  tag  style 
component NM_DHW__N10 pipe in dhw at  tag  style 
  dn = 25 NominalDiameter  
  length = 10 Length  
component NM_FLR node in floor at  tag  style 
component NM_FLR__N9 pipe in floor at  tag  style 
  dn = 25 NominalDiameter  
  length = 15 Length  
component NM_RAD node in radiators at  tag  style 
component NM_RAD__N7 pipe in radiators at  tag  style 
  dn = 25 NominalDiameter  
  length = 18 Length  
component NR node in heating at  tag  style 
component NS node in heating at  tag  style 
component NT_AHU node in AHU at  tag  style 
component NT_DHW node in dhw at  tag  style 
component NT_FLR node in floor at  tag  style 
component NT_RAD node in radiators at  tag  style 
component PU_AHU pump in AHU at  tag 101PU01 style 
component PU_DHW pump in dhw at  tag 104PU01 style 
component PU_FLR pump in floor at  tag 103PU01 style 
component PU_RAD pump in radiators at  tag 102PU01 style 
component TC_AHU controller in AHU at  tag 101PID01 style 
  kp = 2 Dimensionless  
component TC_DHW controller in dhw at  tag 104PID01 style 
  kp = 2 Dimensionless  
component TC_FLR controller in floor at  tag 103PID01 style 
  kp = 2 Dimensionless  
component TC_RAD controller in radiators at  tag 102PID01 style 
  kp = 2 Dimensionless  
component TE_AHU t_sensor in AHU at NT_AHU tag 101TE01 style 
component TE_DHW t_sensor in dhw at NT_DHW tag 104TE01 style 
component TE_FLR t_sensor in floor at NT_FLR tag 103TE01 style 
component TE_R t_sensor in heating at NR tag 100TE02 style 
component TE_RAD t_sensor in radiators at NT_RAD tag 102TE01 style 
component TE_S t_sensor in heating at NS tag 100TE01 style 
component TV_AHU three_way_valve in AHU at  tag 101TV01 style 
component TV_AHU__PU_AHU node in AHU at  tag  style 
component TV_DHW three_way_valve in dhw at  tag 104TV01 style 
component TV_DHW__PU_DHW node in dhw at  tag  style 
component TV_FLR three_way_valve in floor at  tag 103TV01 style 
component TV_FLR__PU_FLR node in floor at  tag  style 
component TV_RAD three_way_valve in radiators at  tag 102TV01 style 
component TV_RAD__PU_RAD node in radiators at  tag  style 
connection HE_AHU.out -> NM_AHU.
connection HE_DHW.out -> NM_DHW.
connection HE_FLR.out -> NM_FLR.
connection HE_RAD.out -> NM_RAD.
connection HS1.out -> NS.
connection N1. -> HS1.in
connection N10. -> N9.
connection N3. -> N3__TV_RAD.in
connection N3. -> N4.
connection N3__TV_RAD.out -> N3__TV_RAD__out.
