connection NM_AHU. -> TV_AHU.b
connection NM_AHU__N8.out -> N8.
connection NM_DHW. -> NM_DHW__N10.in
connection NM_DHW. -> TV_DHW.b
connection NM_DHW__N10.out -> N10.
connection NM_FLR. -> NM_FLR__N9.in
connection NM_FLR. -> TV_FLR.b
connection NM_FLR__N9.out -> N9.
connection NM_RAD. -> NM_RAD__N7.in
connection NM_RAD. -> TV_RAD.b
connection NM_RAD__N7.out -> N7.
connection NR. -> N1.
connection NS. -> N3.
connection NT_AHU. -> HE_AHU.in
connection NT_DHW. -> HE_DHW.in
connection NT_FLR. -> HE_FLR.in
connection NT_RAD. -> HE_RAD.in
connection PU_AHU.out -> NT_AHU.
connection PU_DHW.out -> NT_DHW.
connection PU_FLR.out -> NT_FLR.
connection PU_RAD.out -> NT_RAD.
connection TV_AHU.ab -> TV_AHU__PU_AHU.
connection TV_AHU__PU_AHU. -> PU_AHU.in
connection TV_DHW.ab -> TV_DHW__PU_DHW.
connection TV_DHW__PU_DHW. -> PU_DHW.in
connection TV_FLR.ab -> TV_FLR__PU_FLR.
connection TV_FLR__PU_FLR. -> PU_FLR.in
connection TV_RAD.ab -> TV_RAD__PU_RAD.
connection TV_RAD__PU_RAD. -> PU_RAD.in
control TC_AHU moves PropertyReference { Component = TV_AHU, Property = position } reads PropertyReference { Component = TE_AHU, Property = t } setpoint 323.15 Temperature [] band - differential - output -..- curve 
