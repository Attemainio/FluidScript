# Layout ladder, step 8e (plan/20-core-domain/29-layout-ladder.md): three branches in parallel on
# one header, the middle one two loops in series. The AHU and the DHW take the 60 C supply at 50/30;
# the middle branch feeds the radiators at 50/40 and 20 kW, which fixes its stream at 0.239 kg/s,
# and the floor then cools that stream from 40 to 30 with its duty sized (10 kW), mixing the 40 it
# is fed with its own 30 return half and half to its 35 inlet. HS1 states the total. N11 joins the
# radiators' return to the floor's supply inside the branch and is inline.

fluidscript 2

project "plant_01":
circuit "heating":
  fluid = water
  number = 100
  role = heating

  HS1  heat_exchanger  power = 66 kW  out.t = 60

  N1 - HS1 - N3
  N3 - N4
  N4 - N5
  N9 - N8
  N8 - N7
  N7 - N1

  N1  node  p = 250

circuit "AHU":
  number = 101
  role = ahu

  HE_AHU  load  in.t = 50  out.t = 30  power = 24 kW
  TV_AHU  three_way_valve
  PU_AHU  pump

  N3 - TV_AHU   12 m  DN25
  NM_AHU - TV_AHU
  TV_AHU - PU_AHU - HE_AHU - NM_AHU
  NM_AHU - N7   12 m  DN25

circuit "radiators":
  number = 102
  role = radiator

  HE_RAD  load  in.t = 50  out.t = 40  power = 20 kW
  TV_RAD  three_way_valve
  PU_RAD  pump

  N4 - TV_RAD   18 m  DN25
  NM_RAD - TV_RAD
  TV_RAD - PU_RAD - HE_RAD - NM_RAD
  NM_RAD - N11   18 m  DN25

circuit "floor":
  number = 103

  HE_FLR  load  in.t = 35  out.t = 30
  TV_FLR  three_way_valve
  PU_FLR  pump

  N11 - TV_FLR   15 m  DN25
  NM_FLR - TV_FLR
  TV_FLR - PU_FLR - HE_FLR - NM_FLR
  NM_FLR - N8   15 m  DN25

circuit "dhw":
  number = 104
  role = hot_water

  HE_DHW  load  in.t = 50  out.t = 30  power = 12 kW
  TV_DHW  three_way_valve
  PU_DHW  pump

  N5 - TV_DHW   10 m  DN25
  NM_DHW - TV_DHW
  TV_DHW - PU_DHW - HE_DHW - NM_DHW
  NM_DHW - N9   10 m  DN25
