project project cases [] design  start 
style spacing  default StyleSpec { Stroke = , StrokeWidth = , Corner = , Pattern = , Fill = , IsEmpty = True }
circuit coolingLoop 100 water cooling
component 3WV three_way_valve in coolingLoop at  tag 100TV01 style 
component 3WV__N3 pipe in coolingLoop at  tag  style 
  dn = 25 NominalDiameter  
  length = 25 Length  
component 3WV__N3__in node in coolingLoop at  tag  style 
component HE1 heat_exchanger in coolingLoop at  tag 100HE01 style 
  out = 303.15 Temperature  
  power = -30000 Power  
component HE1__3WV node in coolingLoop at  tag  style 
component N1 inlet in coolingLoop at  tag  style 
  p = 300000 Pressure  
  t = 333.15 Temperature  
component N2 node in coolingLoop at  tag  style 
component N3 outlet in coolingLoop at  tag  style 
  p = 280000 Pressure  
component NM node in coolingLoop at  tag  style 
component PU1 pump in coolingLoop at  tag 100PU01 style 
component PU1__HE1 node in coolingLoop at  tag  style 
component TC1 controller in coolingLoop at  tag 100PID01 style 
  kp = 2 Dimensionless  
component TE1 t_sensor in coolingLoop at NM tag 100TE01 style 
connection 3WV.a -> 3WV__N3__in.
connection 3WV.b -> N2.
connection 3WV__N3.out -> N3.
connection 3WV__N3__in. -> 3WV__N3.in
connection HE1.out -> HE1__3WV.
connection HE1__3WV. -> 3WV.ab
connection N1. -> N2.
connection N2. -> NM.
connection NM. -> PU1.in
connection PU1.out -> PU1__HE1.
connection PU1__HE1. -> HE1.in
control TC1 moves PropertyReference { Component = 3WV, Property = position } reads PropertyReference { Component = TE1, Property = t } setpoint 323.15 Temperature [] band - differential - output -..- curve 
